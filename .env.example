# Copy this file to `.env` in the repo root or `backend/.env` and fill it in.
# Both locations are git-ignored. NEVER commit keys or put them in frontend code.

# --- Nebius Token Factory (required for real AI calls) ---
# Create a key at https://tokenfactory.nebius.com  (API keys -> Create API key)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the id EXACTLY from `python scripts/check_llm.py` (ids differ in casing across models).
# Default below is a best guess from public docs and is NOT yet verified against your account.
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# --- NVIDIA API Catalog (OpenAI-compatible chat completions) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=backend/cygnus.db

# --- Optional, later (Tavily bonus prize needs a real runtime call) ---
# TAVILY_API_KEY=
